[Unit]
Description=Scullion meal planner
After=network.target

[Service]
Type=exec
User=scullion
Group=scullion
WorkingDirectory=/opt/scullion
EnvironmentFile=/etc/scullion/env
ExecStart=/opt/scullion/bin/scullion start
ExecStop=/opt/scullion/bin/scullion stop
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
