[Unit]
Description=Tore meal planner
After=network.target

[Service]
Type=exec
User=tore
Group=tore
WorkingDirectory=/opt/tore
EnvironmentFile=/etc/tore/env
ExecStart=/opt/tore/bin/tore start
ExecStop=/opt/tore/bin/tore stop
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
