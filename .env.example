# OpenRouter (you provide your key)
OPENROUTER_API_KEY=

# OpenRouter model overrides (optional — defaults shown)
OPENROUTER_MODEL=openai/gpt-5-mini
OPENROUTER_VISION_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_CLASSIFIER_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image-preview
OPENROUTER_CHECK_MODEL=openai/gpt-oss-120b:free
OPENROUTER_CHECK_MODEL_FALLBACK=openai/gpt-oss-120b

# Local Garage S3 — you CHOOSE these once; bin/garage-bootstrap.sh imports them.
# Key id must be GK-prefixed; secret a 64-char hex string. Generate e.g.:
#   GARAGE_ACCESS_KEY_ID="GK$(openssl rand -hex 13)"
#   GARAGE_SECRET_ACCESS_KEY="$(openssl rand -hex 32)"
GARAGE_ACCESS_KEY_ID=dbc80ab3a2821e4a053b61745d
GARAGE_SECRET_ACCESS_KEY=4af7c77e1bfab42a7aa5396a92f3ed3b4f8204a7777f969ef1ea9733271b1683
GARAGE_HOST=localhost
GARAGE_PORT=3900
